prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the scenario corpus every host answering this protocol is tested with, and the source of its runner, built against
# these headers and this library: <runner> <port> <scenarios> NAME=value ...
scenarios=${datadir}/plugin-hostd-protocol/host-scenarios.txt
runner=${datadir}/plugin-hostd-protocol/host_scenarios.c
# the commands, replies and error codes (doc/protocol.md)
protocoldoc=${datadir}/plugin-hostd-protocol/protocol.md
# the declared protocol: the one verb table, the grammar of a line (ABNF), what plugin-hostd/protocol.h declares as JSON
# and its schema, and mod-host's commands and codes as JSON. The headers are <plugin-hostd/protocol.h> and the ones it
# includes, found with the Cflags below; data/verbs.json is the package plugin-hostd-protocol of omx-contract's
# contract directory.
protocoldir=${datadir}/plugin-hostd-protocol
table=${protocoldir}/plugin-hostd-protocol.json
grammar=${protocoldir}/plugin-hostd-protocol.abnf
protocoljson=${protocoldir}/plugin-hostd.json
protocolschema=${protocoldir}/plugin-hostd.schema.json
modhostjson=${protocoldir}/mod-host.json

Name: plugin-hostd-protocol
Description: The plugin-hostd protocol: socket server, line protocol and command dispatch, a superset of mod-host's
Version: @VERSION@
Cflags: -I${includedir}/plugin-hostd-protocol
Libs: -L${libdir} -lplugin-hostd-protocol
Libs.private: -lpthread -lm

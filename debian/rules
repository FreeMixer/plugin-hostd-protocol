#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

MAKE_VARS = PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- $(MAKE_VARS)

override_dh_auto_install:
	dh_auto_install -- $(MAKE_VARS)
	# data/verbs.json, as the package plugin-hostd-protocol of omx-contract's contract directory
	$(MAKE) install-contract DESTDIR=$(CURDIR)/debian/tmp PREFIX=/usr

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) test
endif
